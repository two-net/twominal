{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Twominal",
  "version": "0.1.0",
  "identifier": "com.twominal.twominal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Twominal",
        "width": 1024,
        "height": 680,
        "minWidth": 720,
        "minHeight": 420,
        "center": true,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Visible",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "hardenedRuntime": true
    }
  }
}
